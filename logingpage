<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PhotoShare Login</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#fafafa;
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
}

.container{
    width:350px;
}

.login-box{
    background:#fff;
    border:1px solid #dbdbdb;
    padding:40px;
    text-align:center;
}

.logo{
    font-size:38px;
    font-weight:bold;
    margin-bottom:30px;
    font-family:cursive;
}

input{
    width:100%;
    padding:10px;
    margin:6px 0;
    border:1px solid #dbdbdb;
    border-radius:4px;
    background:#fafafa;
}

button{
    width:100%;
    padding:10px;
    margin-top:10px;
    background:#0095f6;
    color:white;
    border:none;
    border-radius:4px;
    font-weight:bold;
    cursor:pointer;
}

button:hover{
    background:#0077cc;
}

.or{
    margin:20px 0;
    color:#777;
}

.facebook{
    color:#385185;
    text-decoration:none;
    font-weight:bold;
}

.forgot{
    display:block;
    margin-top:15px;
    text-decoration:none;
    color:#00376b;
    font-size:14px;
}

.signup{
    margin-top:15px;
    background:#fff;
    border:1px solid #dbdbdb;
    padding:20px;
    text-align:center;
}
</style>
</head>

<body>

<div class="container">

<div class="login-box">
<div class="logo">PhotoShare</div>

<form>
<input type="text" placeholder="Phone number, username, or email">
<input type="password" placeholder="Password">

<button type="submit">Log In</button>
</form>

<div class="or">OR</div>

<a href="#" class="facebook">Log in with Facebook</a>

<a href="#" class="forgot">Forgot password?</a>
</div>

<div class="signup">
Don't have an account?
<a href="#">Sign up</a>
</div>

</div>

</body>
</html>
