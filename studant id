<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Student Search System</title>

<style>
body{
font-family:Arial;
background:#f2f2f2;
text-align:center;
}

.container{
width:350px;
margin:auto;
margin-top:40px;
background:white;
padding:20px;
border-radius:10px;
box-shadow:0 0 10px gray;
}

input{
width:90%;
padding:10px;
font-size:18px;
margin:10px;
}

button{
padding:10px 20px;
font-size:18px;
background:blue;
color:white;
border:none;
border-radius:5px;
cursor:pointer;
}

button:hover{
background:darkblue;
}

#result{
margin-top:20px;
text-align:left;
font-size:18px;
}
</style>

</head>

<body>

<div class="container">

<h2>Student Search</h2>

<input type="number" id="sid" placeholder="Enter Student ID">

<br>

<button onclick="searchStudent()">Search</button>

<div id="result"></div>

</div>

<script>

const students={

137732:{
name:"chavda vanita",
course:"Junior Software Developer",
age:20
},

13734:{
name:"chavda nita",
course:"Junior Software Developer",
age:22
},



};

function searchStudent(){

let id=document.getElementById("sid").value;

let s=students[id];

if(s){

document.getElementById("result").innerHTML=

"<h3>Student Details</h3>"+

"<b>ID :</b> "+id+"<br><br>"+

"<b>Name :</b> "+s.name+"<br><br>"+

"<b>Course :</b> "+s.course+"<br><br>"+

"<b>Age :</b> "+s.age;

}

else{

document.getElementById("result").innerHTML="<h3 style='color:red;'>Student Not Found</h3>";

}

}

</script>

</body>
</html>
